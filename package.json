{
  "name": "protocol-lethe",
  "version": "0.1.0",
  "private": true,
  "description": "Протокол: Лета — мобильный психологический хоррор на 20 минут",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "vite build",
    "preview": "vite preview --host",
    "build:phone": "node scripts/build-phone.mjs",
    "android:init": "cap add android && node scripts/patch-native.mjs android",
    "ios:init": "cap add ios && node scripts/patch-native.mjs ios",
    "android": "vite build && cap sync android && cap open android",
    "ios": "vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-community/screen-brightness": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/neucha": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "esbuild": "^0.28.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
